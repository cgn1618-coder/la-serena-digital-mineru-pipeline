# Credenciales del pipeline La Serena Digital.
#
#   cp .env.example .env      # 1. crea tu copia
#   $EDITOR .env              # 2. sustituye TODOS los your_..._here
#   python auth.py            # 3. comprueba que los servicios las aceptan
#
# .env está en .gitignore: nunca lo subas al repositorio.

# --- Neo4j (grafo de conocimiento) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# --- Qdrant (base vectorial) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_key_here
QDRANT_COLLECTION=earth_sciences
# Permitir acceso sin autenticar. Solo para una instancia local de desarrollo:
# con true el pipeline escribe vectores sin credenciales. Déjalo en false en
# cualquier despliegue accesible desde la red.
QDRANT_ALLOW_ANONYMOUS=false

# --- MinerU (API v4) ---
MINERU_TOKEN=your_mineru_jwt_here

# --- Ajustes opcionales (valores por defecto entre paréntesis) ---
# EMBEDDING_MODEL=BAAI/bge-m3
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64
# MINERU_POLL_MAX_ROUNDS=120        # rondas máximas de espera en mineru_poll.py
